@model FrontEndPagoPA.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<section class="dashboard-hero fade-in">
    <div>
        <span class="eyebrow">Dashboard</span>
        <h1>Buongiorno, <span>@Model.User.businessName</span></h1>
        <p>Gestisci le attività pagoPA del tuo ente in modo rapido e sicuro.</p>
    </div>
    <div class="dashboard-date"><i class='bx bx-calendar'></i><span>@DateTime.Now.ToString("dddd d MMMM", new System.Globalization.CultureInfo("it-IT"))</span></div>
</section>

@{
    var contractExpired = Model.Contract != null && Model.Contract.endDate.Date < DateTime.Today;
    var contractUpcoming = Model.Contract != null && Model.Contract.startDate.Date > DateTime.Today;
}
<section class="contracts-overview fade-in @(contractExpired ? "is-expired" : Model.Contract?.exhausted == true ? "is-exhausted" : contractUpcoming ? "is-upcoming" : "")" aria-labelledby="contracts-title">
    <div class="contracts-overview__header">
        <div class="contracts-overview__title">
            <span class="contracts-overview__icon"><i class='bx bx-receipt'></i></span>
            <span><strong id="contracts-title">Contratti</strong><small>Disponibilità IUV del tuo ente</small></span>
        </div>
        @if (Model.Contract != null)
        {
            @if (contractExpired)
            {
                <span class="contracts-overview__status is-expired"><i class='bx bx-error-circle'></i> Scaduto il @Model.Contract.endDate.ToString("dd/MM/yyyy")</span>
            }
            else if (contractUpcoming)
            {
                <span class="contracts-overview__status is-upcoming"><i class='bx bx-time-five'></i> Inizia il @Model.Contract.startDate.ToString("dd/MM/yyyy")</span>
            }
            else
            {
                <span class="contracts-overview__period"><i class='bx bx-calendar'></i> @Model.Contract.startDate.ToString("dd/MM/yyyy") — @Model.Contract.endDate.ToString("dd/MM/yyyy")</span>
            }
        }
    </div>

    @if (Model.Contract != null)
    {
        var purchasedIuvCount = Model.Contract.totalPurchasedIuvCount > 0 ? Model.Contract.totalPurchasedIuvCount : Model.Contract.purchasedIuvCount;
        var usedPercentage = purchasedIuvCount > 0
            ? (int)Math.Round(Model.Contract.paidIuvCount * 100d / purchasedIuvCount)
            : 0;
        var progressWidth = Math.Min(100, Math.Max(0, usedPercentage));
        var isOverLimit = usedPercentage > 100;
        var isLow = Model.Contract.remainingIuvCount < purchasedIuvCount * .15;

        @if (contractExpired)
        {
            <div class="contracts-overview__expired-notice"><i class='bx bx-error'></i><span><strong>Contratto scaduto</strong><small>Il contratto non è più attivo. Contatta l’assistenza per il rinnovo.</small></span></div>
        }
        else if (Model.Contract.exhausted)
        {
            <div class="contracts-overview__alert"><i class='bx bx-error-circle'></i><span><strong>Disponibilità IUV esaurita</strong><small>Non risultano più IUV disponibili sul contratto attivo. Contatta l’amministratore per integrare il contratto.</small></span></div>
        }

        <div class="contracts-overview__content">
            <div class="contracts-overview__balance @(isLow ? "is-low" : "")">
                <span>@(contractExpired ? "IUV residui alla scadenza" : "IUV disponibili")</span>
                <strong>@Model.Contract.remainingIuvCount.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong>
                <small>@(contractExpired ? "Contratto non utilizzabile" : Model.Contract.exhausted ? "Disponibilità terminata" : isLow ? "Disponibilità in esaurimento" : "Contratto attivo")</small>
            </div>
            <div class="contracts-overview__metrics">
                <div><span>Acquistati</span><strong>@purchasedIuvCount.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong></div>
                <div><span>Generati</span><strong>@Model.Contract.totalIuvCount.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong></div>
                <div><span>Rendicontati</span><strong>@Model.Contract.paidIuvCount.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong></div>
            </div>
            <div class="contracts-overview__usage @(isOverLimit ? "is-over-limit" : "")" aria-label="@usedPercentage% degli IUV acquistati rendicontati">
                <span class="contracts-overview__track"><span style="width:@progressWidth%"></span></span>
                <small><span>Utilizzo</span><strong>@usedPercentage%</strong></small>
                @if (Model.Contract.totalPrice.HasValue)
                {
                    <small><span>Valore contratto</span><strong>@Model.Contract.totalPrice.Value.ToString("C2", new System.Globalization.CultureInfo("it-IT"))</strong></small>
                }
            </div>
        </div>
    }
    else if (!Model.ContractSummaryAvailable)
    {
        <div class="contracts-overview__empty"><i class='bx bx-cloud-off'></i><span><strong>Dati non disponibili</strong><small>Il riepilogo dei contratti non può essere caricato in questo momento.</small></span></div>
    }
    else
    {
        <div class="contracts-overview__empty"><i class='bx bx-info-circle'></i><span><strong>Nessun contratto configurato</strong><small>Contatta l’assistenza per verificare la disponibilità assegnata al tuo ente.</small></span></div>
    }
</section>

<section class="quick-actions fade-in" aria-labelledby="quick-actions-title">
    <div class="section-heading"><div><span class="eyebrow">Azioni rapide</span><h2 id="quick-actions-title">Cosa vuoi fare?</h2></div></div>
    <div class="quick-actions__grid">
        <a href="/IuvSingolo/Index" class="action-card action-card--primary"><span class="action-card__icon"><i class='bx bx-file'></i></span><span class="action-card__content"><strong>Nuova posizione singola</strong><small>Genera uno IUV per un singolo debitore</small></span><i class='bx bx-right-arrow-alt action-card__arrow'></i></a>
        <a href="/IuvMultiplo/Index" class="action-card"><span class="action-card__icon"><i class='bx bx-layer'></i></span><span class="action-card__content"><strong>Posizioni multiple</strong><small>Importa e gestisci più posizioni insieme</small></span><i class='bx bx-right-arrow-alt action-card__arrow'></i></a>
        <a href="/User/PersonalArea" class="action-card"><span class="action-card__icon"><i class='bx bx-user'></i></span><span class="action-card__content"><strong>Dati dell’ente</strong><small>Aggiorna profilo e informazioni di accesso</small></span><i class='bx bx-right-arrow-alt action-card__arrow'></i></a>
    </div>
</section>

<section class="dashboard-reports fade-in" aria-labelledby="reports-title">
    <div class="section-heading"><div><span class="eyebrow">Menu veloce</span><h2 id="reports-title">Gestione e monitoraggio</h2></div></div>
    <div class="report-grid">
        <a class="report-card report-card--waiting" href="/Action/RichiesteInAttesa"><span class="report-card__icon"><i class='bx bx-time-five'></i></span><span><strong>Richieste in attesa</strong><small>Controlla le operazioni da completare</small></span><i class='bx bx-chevron-right'></i></a>
        <a class="report-card report-card--success" href="/Action/RichiesteEsitate"><span class="report-card__icon"><i class='bx bx-check-circle'></i></span><span><strong>Richieste esitate</strong><small>Consulta gli esiti delle richieste inviate</small></span><i class='bx bx-chevron-right'></i></a>
        <a class="report-card report-card--error" href="/Action/RichiesteNonValidate"><span class="report-card__icon"><i class='bx bx-error-circle'></i></span><span><strong>Richieste non valide <span id="invalid-iuv-count" class="report-card__count">—</span></strong><small>Consulta gli IUV rifiutati e il motivo dell’errore</small></span><i class='bx bx-chevron-right'></i></a>
        <a class="report-card report-card--payments" href="/Action/RendicontazionePagamenti"><span class="report-card__icon"><i class='bx bx-euro'></i></span><span><strong>Rendicontazione</strong><small>Verifica incassi e pagamenti ricevuti</small></span><i class='bx bx-chevron-right'></i></a>
        <a class="report-card report-card--history" href="/Action/StoricoOperazioni"><span class="report-card__icon"><i class='bx bx-archive'></i></span><span><strong>Storico operazioni</strong><small>Consulta tutte le operazioni effettuate</small></span><i class='bx bx-chevron-right'></i></a>
        <a class="report-card report-card--users" href="/User/UsersList"><span class="report-card__icon"><i class='bx bx-group'></i></span><span><strong>Utenti</strong><small>Gestisci gli utenti e le relative autorizzazioni</small></span><i class='bx bx-chevron-right'></i></a>
    </div>
</section>

<script src="~/js/private/Dashboard.js" asp-append-version="true"></script>
