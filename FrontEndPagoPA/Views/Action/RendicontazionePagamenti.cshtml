@model List<FrontEndPagoPA.Models.DebtPositionInstallmentViewModel>

@{
    ViewBag.Title = "Rendicontazione Pagamenti";
}

<div class="row">
    <div class="col-lg-12 fade-in">
        <h4>Archivio richieste</h4>
        <h1>Rendicontazione pagamenti</h1>
    </div>
</div>

<div class="row fade-in">
    <div class="col-md-12">
        <div class="card request-archive">
            <div class="row">
                <div class="col-md-12">
                    <h5>Filtra lista per:</h5>
                </div>
            </div>
            <div class="row form-site p-0">
                <form class="pt-10">
                    <div class="row">
                        <input type="text" name="worked" id="worked" value="true" hidden />
                        <input type="text" name="valid" id="valid" value="true" hidden />
                        <div class="col-md-2">
                            <label>
                                Data inizio
                                <input type="date" name="dataInizio" id="dataInizio" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </label>
                        </div>
                        <div class="col-md-2">
                            <label>
                                Data fine
                                <input type="date" name="dataFine" id="dataFine" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </label>
                        </div>
                        <div class="col-md-2">
                            <label>Codice Fiscale</label>
                            <input type="text" name="codiceFiscale" id="codiceFiscale" />
                        </div>
                        <div class="col-md-2">
                            <label>IUV</label>
                            <input type="text" name="iuv" id="iuv" />
                        </div>
                        <div class="col-md-4">
                            <label>Nominativo</label>
                            <input type="text" name="nominativo" id="nominativo" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-2">
                            <label>
                                Importo min
                                <input type="number" name="importoMinimo" id="importoMinimo" min="0" step="0.01" />
                            </label>
                        </div>
                        <div class="col-md-2 col-sm-2">
                            <label>
                                Importo max
                                <input type="number" name="importoMassimo" id="importoMassimo" min="0" step="0.01" />
                            </label>
                        </div>
                        <div class="col-md-2">
                            <label>Pagata</label>
                            <select name="type" id="pagato">
                                <option>SI</option>
                                <option>NO</option>
                            </select>
                        </div>
                        <div class="col-md-2 col-sm-2">
                            <div>
                                <input type="button" id="filtraRichieste" value="CERCA" name="cerca" class="btn_filter" onclick="FiltraRichieste()" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2">
                            <div>
                                <input type="button" id="svuota" value="SVUOTA" name="svuota" class="btn_filter" onclick="EliminaFiltro()" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4">
                            <div>
                                <input type="button" value="SCARICA LISTA IN CSV" name="download_list" class="btn_filter btn-download-list" onclick="GeneraCsv()" />
                            </div>
                        </div>
                    </div>
                </form>

            </div>

            <div class="row">
                <div class="col-md-12">
                    <!--archive list header-->
                    <ul class="archive-payments__header">
                        <li>Nominativo</li>
                        <li>Codice fiscale</li>
                        <li>IUV</li>
                        <li>Tipologia</li>
                        <li>Importo</li>
                        <li>Rata</li>
                        <li>Data scadenza</li>
                        <li class='text-center'>Pagata</li>
                        <li class='text-center'>Data pag.</li>
                        <li class='text-center'>Azioni</li>
                    </ul>
                    <div class="preload preload-mini"><i class='bx bx-loader bx-spin'></i><br /><p>Attendere caricamento in corso...</p></div>
                    <!--end archive list header-->
                    <div class="archive-payments">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="divider"></div>
                    <div class="pagination">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updateExpirationModal" tabindex="-1" aria-labelledby="updateExpirationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content expiration-modal">
            <div class="modal-header expiration-modal__header">
                <div class="expiration-modal__title">
                    <span class="expiration-modal__icon"><i class='bx bx-calendar-edit'></i></span>
                    <div>
                        <span class="expiration-modal__eyebrow">Rinnovo posizione</span>
                        <h5 class="modal-title" id="updateExpirationModalLabel">Modifica scadenza IUV</h5>
                    </div>
                </div>
                <button type="button" class="expiration-modal__close" data-bs-dismiss="modal" aria-label="Chiudi">
                    <i class='bx bx-x'></i>
                </button>
            </div>
            <div class="modal-body expiration-modal__body">
                <input type="hidden" id="updateExpirationInstallmentId" />
                <div class="expiration-modal__iuv">
                    <span>IUV</span>
                    <strong id="updateExpirationIuv"></strong>
                </div>
                <p class="expiration-modal__intro">Scegli una nuova scadenza valida. La posizione sarà reinviata automaticamente per l’elaborazione.</p>
                <div class="expiration-modal__dates">
                    <label>
                        <span>Scadenza attuale</span>
                        <input type="date" id="currentExpirationDate" disabled />
                    </label>
                    <i class='bx bx-right-arrow-alt'></i>
                    <label>
                        <span>Nuova scadenza</span>
                        <input type="date" id="newExpirationDate" required />
                    </label>
                </div>
                <div id="updateExpirationMessage" class="expiration-modal__message"></div>
            </div>
            <div class="modal-footer expiration-modal__footer">
                <button type="button" class="expiration-modal__cancel" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="expiration-modal__confirm" id="confirmExpirationUpdate" onclick="UpdateExpirationDate()">
                    <i class='bx bx-refresh'></i>
                    Aggiorna e reinvia
                </button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/private/rendicontazionePagamenti.js" asp-append-version="true"></script>
