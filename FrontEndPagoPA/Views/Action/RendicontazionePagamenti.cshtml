@model List<FrontEndPagoPA.Models.DebtPositionInstallmentViewModel>

@{
    ViewBag.Title = "Rendicontazione Pagamenti";
}

<div class="row">
    <div class="col-lg-12 fade-in">
        <h4>Archivio richieste</h4>
        <h1>Rendicontazione pagamenti</h1>
    </div>
</div>

<div class="row fade-in">
    <div class="col-md-12">
        <details class="archive-filter-panel">
            <summary class="archive-filter-panel__summary">
                <span class="archive-filter-panel__icon"><i class='bx bx-filter-alt'></i></span>
                <span class="archive-filter-panel__copy">
                    <strong>Filtri pagamenti</strong>
                    <small>Ricerca incassi per debitore, IUV, data o importo</small>
                </span>
                <span class="archive-filter-panel__state"><i class='bx bx-chevron-down'></i></span>
            </summary>
            <div class="archive-filter-panel__body">
                <div class="form-site">
                  <form class="archive-filter-form">
                        <input type="text" name="worked" id="worked" value="true" hidden />
                        <input type="text" name="valid" id="valid" value="true" hidden />
                        <div class="archive-filter-grid archive-filter-grid--payments">
                            <label>Data inizio<input type="date" name="dataInizio" id="dataInizio" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
                            <label>Data fine<input type="date" name="dataFine" id="dataFine" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
                            <label>Codice fiscale<input type="text" name="codiceFiscale" id="codiceFiscale" /></label>
                            <label>IUV<input type="text" name="iuv" id="iuv" /></label>
                            <label>Nominativo<input type="text" name="nominativo" id="nominativo" /></label>
                            <label>Importo min<input type="number" name="importoMinimo" id="importoMinimo" min="0" step="0.01" /></label>
                            <label>Importo max<input type="number" name="importoMassimo" id="importoMassimo" min="0" step="0.01" /></label>
                            <label>Pagata<select name="type" id="pagato"><option>SI</option><option>NO</option></select></label>
                        </div>
                        <div class="archive-filter-actions">
                            <input type="button" id="filtraRichieste" value="CERCA" name="cerca" class="btn_filter" onclick="FiltraRichieste()" />
                            <input type="button" id="svuota" value="SVUOTA" name="svuota" class="btn_filter" onclick="EliminaFiltro()" />
                            <input type="button" value="SCARICA CSV" name="download_list" class="btn_filter btn-download-list" onclick="GeneraCsv()" />
                        </div>
                  </form>
                </div>
            </div>
        </details>

        <section class="card archive-table-card">
            <div class="archive-table-toolbar">
                <span class="archive-table-toolbar__icon"><i class='bx bx-receipt'></i></span>
                <span><strong>Pagamenti rendicontati</strong><small>Incassi, scadenze e stato delle posizioni</small></span>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <!--archive list header-->
                    <ul class="archive-payments__header">
                        <li>Nominativo</li>
                        <li>Codice fiscale</li>
                        <li>IUV</li>
                        <li>Tipologia</li>
                        <li>Importo</li>
                        <li>Rata</li>
                        <li>Data scadenza</li>
                        <li class='text-center'>Stato pagamento</li>
                        <li class='text-center'>Data pag.</li>
                        <li class='text-center'>Azioni</li>
                    </ul>
                    <div class="preload preload-mini"><i class='bx bx-loader bx-spin'></i><br /><p>Attendere caricamento in corso...</p></div>
                    <!--end archive list header-->
                    <div class="archive-payments">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="divider"></div>
                    <div class="table-footer-bar">
                        <label class="table-page-size">
                            <span>Record per pagina</span>
                            <select onchange="ChangeItemsPerPage(this.value)" aria-label="Record per pagina">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100" selected>100</option>
                                <option value="200">200</option>
                                <option value="500">500</option>
                            </select>
                        </label>
                        <div class="pagination"></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="modal fade" id="updateExpirationModal" tabindex="-1" aria-labelledby="updateExpirationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content expiration-modal">
            <div class="modal-header expiration-modal__header">
                <div class="expiration-modal__title">
                    <span class="expiration-modal__icon"><i class='bx bx-calendar-edit'></i></span>
                    <div>
                        <span class="expiration-modal__eyebrow">Rinnovo posizione</span>
                        <h5 class="modal-title" id="updateExpirationModalLabel">Modifica scadenza IUV</h5>
                    </div>
                </div>
                <button type="button" class="expiration-modal__close" data-bs-dismiss="modal" aria-label="Chiudi">
                    <i class='bx bx-x'></i>
                </button>
            </div>
            <div class="modal-body expiration-modal__body">
                <input type="hidden" id="updateExpirationInstallmentId" />
                <div class="expiration-modal__iuv">
                    <span>IUV</span>
                    <strong id="updateExpirationIuv"></strong>
                </div>
                <p class="expiration-modal__intro">Scegli una nuova scadenza valida. La posizione sarà reinviata automaticamente per l’elaborazione.</p>
                <div class="expiration-modal__dates">
                    <label>
                        <span>Scadenza attuale</span>
                        <input type="date" id="currentExpirationDate" disabled />
                    </label>
                    <i class='bx bx-right-arrow-alt'></i>
                    <label>
                        <span>Nuova scadenza</span>
                        <input type="date" id="newExpirationDate" required />
                    </label>
                </div>
                <div id="updateExpirationMessage" class="expiration-modal__message"></div>
            </div>
            <div class="modal-footer expiration-modal__footer">
                <button type="button" class="expiration-modal__cancel" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="expiration-modal__confirm" id="confirmExpirationUpdate" onclick="UpdateExpirationDate()">
                    <i class='bx bx-refresh'></i>
                    Aggiorna e reinvia
                </button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/private/RendicontazionePagamenti.js" asp-append-version="true"></script>
