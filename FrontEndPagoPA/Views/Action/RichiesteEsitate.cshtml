@model List<FrontEndPagoPA.Models.DebtPositionInstallmentViewModel>

@{
    ViewBag.Title = "Richieste Esitate";
}

<div class="row">
    <div class="col-lg-12 fade-in">
        <h4>Archivio richieste</h4>
        <h1>Richieste Esitate</h1>
    </div>
</div>

<div class="row fade-in">
    <div class="col-md-12">
        <details class="archive-filter-panel">
            <summary class="archive-filter-panel__summary">
                <span class="archive-filter-panel__icon"><i class='bx bx-filter-alt'></i></span>
                <span class="archive-filter-panel__copy">
                    <strong>Filtri richieste</strong>
                    <small>Ricerca per anagrafica, importo o intervallo</small>
                </span>
                <span class="archive-filter-panel__state"><i class='bx bx-chevron-down'></i></span>
            </summary>
            <div class="archive-filter-panel__body">
                <div class="form-site">
                  <form class="archive-filter-form">
                    <div class="archive-filter-grid archive-filter-grid--esitate">
                        <label>Data inizio<input type="date" name="dataInizio" id="dataInizio" /></label>
                        <label>Data fine<input type="date" name="dataFine" id="dataFine" /></label>
                        <label>Codice fiscale<input type="text" name="codiceFiscale" id="codiceFiscale" /></label>
                        <label>IUV<input type="text" name="iuv" id="iuv" /></label>
                        <label>Importo min<input type="number" name="importoMinimo" id="importoMinimo" min="0" step="0.01" /></label>
                        <label>Importo max<input type="number" name="importoMassimo" id="importoMassimo" min="0" step="0.01" /></label>
                    </div>
                    <div class="archive-filter-actions">
                        <input type="button" id="filtraRichieste" value="CERCA" name="cerca" class="btn_filter" onclick="FiltraRichieste()" />
                        <input type="button" id="svuota" value="SVUOTA" name="svuota" class="btn_filter" onclick="EliminaFiltro()" />
                        <input type="button" value="SCARICA CSV" name="download_list" class="btn_filter btn-download-list" onclick="DownloadList()" />
                    </div>
                  </form>
                </div>
            </div>
        </details>

        <section class="card archive-table-card">
            <div class="archive-table-toolbar">
                <span class="archive-table-toolbar__icon"><i class='bx bx-check-circle'></i></span>
                <span><strong>Richieste esitate</strong><small>Posizioni elaborate e relativo stato</small></span>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <!--archive list header-->
                    <ul class="archive-list-accepted__header">
                        <li>Id</li>
                        <li>Codice fiscale</li>
                        <li>IUV</li>
                        <li>Tipologia</li>
                        <li>Importo</li>
                        <li>Rata</li>
                        <li>Data scadenza</li>
                        <li class="text-center">Stato</li>
                    </ul>
                    <!--end archive list header-->
                    <div class="preload preload-mini"><i class='bx bx-loader bx-spin'></i><br /><p>Attendere caricamento in corso...</p></div>
                    <div class="archive-list-accepted">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="divider"></div>
                    <div class="table-footer-bar">
                        <label class="table-page-size">
                            <span>Record per pagina</span>
                            <select onchange="ChangeItemsPerPage(this.value)" aria-label="Record per pagina">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100" selected>100</option>
                                <option value="200">200</option>
                                <option value="500">500</option>
                            </select>
                        </label>
                        <div class="pagination"></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<script src="~/js/private/RichiesteEsitate.js" asp-append-version="true"></script>
