@model List<FrontEndPagoPA.Models.OperationHistoryViewModel>
@{
    ViewBag.Title = "Storico Operazioni";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}


<div class="row">
    <div class="col-lg-12 fade-in">
        <h4>Archivio richieste</h4>
        <h1>Storico operazioni</h1>
    </div>
</div>

<div class="row fade-in">
    <div class="col-md-12">
        <details class="archive-filter-panel">
            <summary class="archive-filter-panel__summary">
                <span class="archive-filter-panel__icon"><i class='bx bx-filter-alt'></i></span>
                <span class="archive-filter-panel__copy">
                    <strong>Filtri storico</strong>
                    <small>Ricerca le operazioni per intervallo di creazione</small>
                </span>
                <span class="archive-filter-panel__state"><i class='bx bx-chevron-down'></i></span>
            </summary>
            <div class="archive-filter-panel__body">
                <div class="form-site">
                    <form class="archive-filter-form archive-filter-form--history">
                        <input type="hidden" name="worked" id="worked" value="false" />
                        <div class="archive-filter-grid archive-filter-grid--history">
                            <label>Data inizio<input type="date" name="dataInizio" id="dataInizio" value="@today" /></label>
                            <label>Data fine<input type="date" name="dataFine" id="dataFine" /></label>
                        </div>
                        <div class="archive-filter-actions">
                            <input type="button" id="filtraRichieste" value="CERCA" name="cerca" class="btn_filter" onclick="FiltraRichieste()" />
                            <input type="button" id="svuota" value="SVUOTA" name="svuota" class="btn_filter" onclick="EliminaFiltro()" />
                            <input type="button" value="SCARICA CSV" name="download_list" class="btn_filter btn-download-list" onclick="DownloadHistoryCsv()" />
                        </div>
                    </form>
                </div>
            </div>
        </details>

        <section class="card archive-table-card">
            <div class="archive-table-toolbar">
                <span class="archive-table-toolbar__icon"><i class='bx bx-history'></i></span>
                <span><strong>Operazioni elaborate</strong><small>Stato, tipologia e documenti generati</small></span>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <ul class="operations-history__header">
                        <li>Operazione</li>
                        <li class='text-center'>Data creazione</li>
                        <li class='text-center'>Tipologia</li>
                        <li class='text-center'>Tipo</li>
                        <li class='text-center'>Stato avanzamento</li>
                        <li class="text-center">Scarica IUV</li>
                        <li class="text-center">Bollettini</li>
                    </ul>
                    <div class="preload preload-mini"><i class='bx bx-loader bx-spin'></i><br /><p>Attendere caricamento in corso...</p></div>
                    <div class="operations-history"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="divider"></div>
                    <div class="table-footer-bar">
                        <label class="table-page-size">
                            <span>Record per pagina</span>
                            <select onchange="ChangeItemsPerPage(this.value)" aria-label="Record per pagina">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100" selected>100</option>
                                <option value="200">200</option>
                                <option value="500">500</option>
                            </select>
                        </label>
                        <div class="pagination"></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<script src="~/js/private/StoricoOperazioni.js" asp-append-version="true"></script>
