@model List<FrontEndPagoPA.Models.DebtPositionInstallmentViewModel>

@{
    ViewBag.Title = "Richieste In Attesa";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row">
    <div class="col-lg-12 fade-in">
        <h4>Archivio richieste</h4>
        <h1>Richieste in attesa di esitazione</h1>
    </div>
</div>

<div class="row fade-in">
    <div class="col-md-12">
        <details class="archive-filter-panel">
            <summary class="archive-filter-panel__summary">
                <span class="archive-filter-panel__icon"><i class='bx bx-filter-alt'></i></span>
                <span class="archive-filter-panel__copy">
                    <strong>Filtri richieste</strong>
                    <small>Ricerca per data, codice fiscale o IUV</small>
                </span>
                <span class="archive-filter-panel__state"><i class='bx bx-chevron-down'></i></span>
            </summary>
            <div class="archive-filter-panel__body">
                <div class="form-site">
                    <form class="archive-filter-form">
                        <input type="hidden" name="worked" id="worked" value="false" />
                        <div class="archive-filter-grid archive-filter-grid--waiting">
                            <label>Data inizio<input type="date" name="dataInizio" id="dataInizio" value="@today" /></label>
                            <label>Data fine<input type="date" name="dataFine" id="dataFine" /></label>
                            <label>Codice fiscale<input type="text" name="codiceFiscale" id="codiceFiscale" /></label>
                            <label>IUV<input type="text" name="iuv" id="iuv" /></label>
                        </div>
                        <div class="archive-filter-actions">
                            <input type="button" id="filtraRichieste" value="CERCA" name="cerca" class="btn_filter" onclick="FiltraRichieste()" />
                            <input type="button" id="svuota" value="SVUOTA" name="svuota" class="btn_filter" onclick="EliminaFiltro()" />
                        </div>
                    </form>
                </div>
            </div>
        </details>

        <section class="card archive-table-card">
            <div class="archive-table-toolbar">
                <span class="archive-table-toolbar__icon"><i class='bx bx-time-five'></i></span>
                <span><strong>Richieste in attesa</strong><small>Posizioni ancora in elaborazione</small></span>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <!--archive list header-->
                    <ul class="archive-list-waiting__header">
                        <li>Id</li>
                        <li>Codice fiscale</li>
                        <li>IUV</li>
                        <li>Tipologia</li>
                        <li>Importo</li>
                        <li>Rata</li>
                        <li>Data scadenza</li>
                        <li>Stato</li>
                    </ul>
                    <!--end archive list header-->
                    <div class="preload preload-mini"><i class='bx bx-loader bx-spin'></i><br /><p>Attendere caricamento in corso...</p></div>
                    <div class="archive-list-waiting">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="divider"></div>
                    <div class="pagination"></div>
                </div>
            </div>
        </section>
    </div>
</div>
<script src="~/js/private/richiesteInAttesa.js" asp-append-version="true"></script>
